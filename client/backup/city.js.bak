/* CITY: enterable venues (hospital, hotel, casino), phone on L (taxi + friend messages). Boot is called at the end of the main script. */
(function(){
const $=id=>document.getElementById(id),clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),money=n=>'$'+Math.round(n);
const css=document.createElement('style');css.textContent=`
#cv{position:fixed;inset:0;z-index:26;background:#0b0618ee;display:flex;flex-direction:column;align-items:center;padding:calc(env(safe-area-inset-top,0px) + 10px) 10px 10px;overflow:auto;touch-action:pan-y}
#cv .in{width:min(96vw,520px)}#cv h2{font:italic 900 26px Impact,sans-serif;background:linear-gradient(#ffe36e,#ff4fa0);-webkit-background-clip:text;color:transparent;margin:0 0 8px}
#cv button{min-width:0;padding:10px 14px;font-size:14px;margin:3px}#cv button.on{background:#ff4fa0;color:#fff}#cv .big{font-size:40px;letter-spacing:6px;text-align:center;margin:12px 0;min-height:52px}#cv input{width:100%;padding:10px;border-radius:8px;border:1px solid #fff5;background:#241a4a;color:#fff;font-size:15px}
#cv .m{padding:6px 10px;border-radius:10px;margin:4px 0;max-width:85%;background:#2b2660;word-break:break-word}#cv .m.me{background:#ff3ea5;margin-left:auto}#cv .sw{display:inline-block;width:42px;height:42px;border-radius:50%;margin:4px;border:2px solid #fff}
#fadev{position:fixed;inset:0;z-index:40;background:#000;color:#fff;display:flex;align-items:center;justify-content:center;font:900 22px system-ui;opacity:0;pointer-events:none;transition:opacity .35s}`;
document.head.appendChild(css);
const TYPES={hospital:{n:'Hospital',c:0x3fe0c8,f:'🏥'},hotel:{n:'Hotel',c:0xff7ab8,f:'🏨'},casino:{n:'Casino',c:0xffd23a,f:'🎰'},gunshop:{n:'Gun Shop',c:0xff4444,f:'🔫'},home:{n:'Home',c:0x66aaff,f:'🏠'},clothes:{n:'Clothing Store',c:0xb86bff,f:'👕'},restaurant:{n:'Restaurant',c:0xffa040,f:'🍔'},cinema:{n:'Cinema',c:0xff3d6e,f:'🎬'},bank:{n:'Bank',c:0x4dd2ff,f:'🏦'},police:{n:'Police Station',c:0x3b6bff,f:'🚓'},military:{n:'Military Base',c:0x6b8f3a,f:'🪖'}},KEYS_=Object.keys(TYPES);
let curP=null,alarm=0,alarmT=0,bankv=0,lastRob=-999,ti=0,muteUntil=0,inside=null,ret=null,rooms={},pts=[],npcs=[],panel=null,bet=200,ph={thread:null,msgs:{},fr:null,tts:true};
const guard=()=>typeof G!=='undefined'&&G&&playing&&!G.paused&&!G.dead;
const me=()=>G.chars[G.ci];
/* ---------- fade ---------- */
function fade(txt,ms,fn){const f=$('fadev');f.textContent=txt||'';f.style.opacity=1;setTimeout(()=>{fn&&fn();setTimeout(()=>f.style.opacity=0,200)},ms)}
/* ---------- venues in the city (door markers use the game's INT list: E to enter, shown on minimap + map) ---------- */
function venues(){for(let i=0;i<N;i++)for(let j=0;j<N;j++){const h=(i*5+j*3)%23,t={0:'hospital',8:'hotel',15:'casino',3:'gunshop',5:'clothes',10:'restaurant',12:'cinema',18:'bank',20:'police'}[h];if(!t||(i===2&&j===0))continue;
 INT.push({x:i*B+B/2,z:j*B+10,n:TYPES[t].n+': enter'+(t==='casino'?' ($100 ticket)':''),c:TYPES[t].c,f(){enter(t)}})}
 INT.push({x:2*B+B/2,z:10,get n(){return home.own?'Home: enter (private — only you)':'Home: for sale $25,000 (press E to buy)'},c:TYPES.home.c,f(){if(home.own)return enter('home');if(G.money<25000)return toast('The house costs $25,000');G.money-=25000;home.own=1;saveHome();toast('You bought a house! Press E again to enter')}});INT.push({x:14*B+B/2,z:2*B+10,n:'Military Base: enter (restricted · $500 visitor pass)',c:TYPES.military.c,f(){enter('military')}})}
function signs(){const tex={};for(const t of KEYS_){const c=document.createElement('canvas');c.width=256;c.height=64;const g=c.getContext('2d');g.fillStyle='#000a';g.fillRect(0,0,256,64);g.font='bold 34px system-ui';g.fillStyle='#fff';g.textAlign='center';g.fillText(TYPES[t].f+' '+TYPES[t].n.toUpperCase(),128,44);tex[t]=new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false})}
 INT.forEach(o=>{const t=KEYS_.find(k=>o.n.indexOf(TYPES[k].n)===0);if(!t)return;const s=new THREE.Sprite(tex[t]);s.scale.set(14,3.5,1);s.position.set(o.x,19,o.z);scene.add(s)})}
/* ---------- interiors ---------- */
const NM=['Alex','Maria','Jin','Dmitri','Sofia','Omar','Lena','Tony','Zoe','Ray'],CHAT=['Nice city, huh? Watch your wallet downtown.','Heard the bank has a weak vault… not that I would know.','Casino gives free drinks if you lose enough.','Cops get nervous when you wave a gun around.','Taxi is cheap if you set a waypoint first.','Stay away from the military base. Seriously.','Try the restaurants — food heals you.','Buy a house! Keep your cash safe.'];
function talk(n,l,back){ti++;open_(n,d=>{const p=document.createElement('p');p.style.fontSize='17px';p.textContent='“'+l[ti%l.length]+'”';d.append(p);btn(d,'Say more',()=>talk(n,l,back));btn(d,back?'Back':'Bye',()=>back?back():closePanel())})}
function menu(title,intro,items,tn,tl){const draw=()=>open_(title,d=>{const m=document.createElement('p');m.textContent=(intro||'')+' Money: '+money(G.money);d.append(m);items.forEach(it=>{const b=btn(d,it[0]+(it[1]?' — '+money(it[1]):''),()=>{if(it[1]&&G.money<it[1])return toast('Not enough money');if(it[3]&&it[3]()===false)return;G.money-=it[1]||0;it[2]();draw()});b.style.cssText='display:block;width:100%'});if(tn)btn(d,'💬 Talk to '+tn,()=>talk(tn,tl,draw));btn(d,'Close',closePanel)});draw()}
function npc(shirt,x,z,o){o=o||{};const m=human(shirt,pick(HC),o.fem==null?Math.random()<.5:o.fem,o.h||{});m.position.set(x,o.y||0,z);m.rotation.y=o.ry||0;if(o.lie)m.rotation.z=Math.PI/2;animH(m,0,0,'idle');if(curP&&!o.lie&&!o.nosay){const nm=o.name||pick(NM);curP.push({x,z,l:'Talk to '+nm,f:()=>talk(nm,o.say||CHAT)})}if(o.watch)npcs.push({m,w:1});if(o.patrol)npcs.push({m,x0:x,z0:z,a:o.patrol,t:Math.random()*6});return m}
function build(t){const X=-3000-KEYS_.indexOf(t)*100,Z=0,H=7,g=new THREE.Group();scene.add(g);
 const M=(c,e)=>new THREE.MeshLambertMaterial({color:c,emissive:c,emissiveIntensity:e==null?.5:e}),
 box=(w,h,d,x,y,z,c,e,wall)=>{const m=new THREE.Mesh(BG,M(c,e));m.scale.set(w,h,d);m.position.set(X+x,y,Z+z);g.add(m);if(wall)addBox({x0:X+x-w/2,x1:X+x+w/2,z0:Z+z-d/2,z1:Z+z+d/2});return m};
 const C={hospital:[0xe9f2f4,0x9fd8d0],hotel:[0xcdb68f,0x9c3f5e],casino:[0x3a1450,0x6a2a8a],gunshop:[0x2d3038,0x5a2a2a],home:[0xe8dcc8,0x6a7a9a],clothes:[0xf3e9f7,0xb86bff],restaurant:[0xf0d9b0,0xa0522d],cinema:[0x1a1020,0x5a1030],bank:[0xe8e4d8,0x2b5f7a],police:[0xc9d2e0,0x2a3f8f],military:[0x5a6048,0x3a4a28]}[t],P=[];curP=P;
 box(32,.2,32,0,-.1,0,C[0],.45);box(32,.2,32,0,H,0,C[0],.25);[[32,H,1,0,H/2,-16],[32,H,1,0,H/2,16],[1,H,32,-16,H/2,0],[1,H,32,16,H/2,0]].forEach(w=>box(...w,C[1],.5,1));
 box(30,.3,.3,0,H-.5,-15.4,TYPES[t].c,1.2);box(5,.15,.4,0,.1,15.3,0x33ff77,1.2); P.push({x:X,z:Z+13.2,l:'Exit',f:()=>leave()});
 const desk=(x,z,w)=>box(w,1.2,2,x,.6,z,0xffffff,.5,1);
 if(t==='hospital'){desk(0,-6,10);npc(0x2ec4b6,X,Z-8,{fem:true});P.push({x:X,z:Z-3.8,l:'Treatment — full heal ($150)',f:()=>{const c=me();if(G.money<150)return toast('Need $150');if(c.hp>=100)return toast('You are healthy');G.money-=150;c.hp=100;fade('🏥 Treatment…',900,()=>toast('Healed'))}});
  [-11,-5].forEach((z,i)=>{box(2,.6,4,-12,.3,z,0xffffff,.5);if(!i)npc(0xf0f0f0,X-12,Z+z,{lie:1,y:.75})});[2,5,8].forEach((z,i)=>npc(pick(PCOL),X+11,Z+z,{ry:-1.6}));npc(0xffffff,X-4,Z+3,{patrol:7,fem:false});npc(0xffffff,X+5,Z-4,{patrol:5,fem:true})}
 if(t==='hotel'){desk(-7,-6,8);npc(0x8a2f4d,X-7,Z-8,{});P.push({x:X-7,z:Z-3.8,l:'Reception — sleep till morning ($200)',f:()=>{if(G.money<200)return toast('Need $200');G.money-=200;fade('😴 Sleeping…',1600,()=>{G.hour=7;me().hp=100;try{save(true)}catch(e){}toast('Good morning · 7:00')})}});
  box(3,4,1.5,10,2,-12.5,0x7a4a2a,.4,1);P.push({x:X+10,z:Z-10.3,l:'Wardrobe — change outfit',f:()=>outfit()});box(7,.8,2.5,-8,.4,8,0xaa3355,.5);box(7,.8,2.5,8,.4,8,0xaa3355,.5);
  [[-4,2],[6,4],[10,-4]].forEach(a=>npc(pick(PCOL),X+a[0],Z+a[1],{ry:rnd(0,6)}));npc(0x222222,X+2,Z+5,{patrol:8})}
 if(t==='casino'){for(let i=0;i<5;i++)box(1.4,2.4,1.4,-14,1.2,-11+i*3.2,[0xff2bd6,0x2bf0ff,0xffd23a,0x7cff6b,0xff6b3a][i],.9,1);P.push({x:X-11.5,z:Z-5,l:'Slot machines',f:()=>slots()});
  box(7,1,3.5,0,.5,-6,0x0a6a3a,.7,1);npc(0x111111,X,Z-8.5,{fem:true});P.push({x:X,z:Z-3.2,l:'Roulette table',f:()=>roulette()});
  box(6,1,3,10,.5,-6,0x0a3a6a,.7,1);npc(0x111111,X+10,Z-8.5,{fem:false});P.push({x:X+10,z:Z-3.2,l:'Dice table',f:()=>dice()});
  [[-4,3],[4,3]].forEach(a=>npc(0x111111,X+a[0],Z+a[1],{h:{police:1,swat:1},fem:false,ry:3.1}));[[-11,-2],[-11,3],[3,-1],[12,-1],[8,2]].forEach(a=>npc(pick(PCOL),X+a[0],Z+a[1],{ry:rnd(0,6)}));npc(0xffd23a,X+6,Z+6,{patrol:6,fem:true})}
 if(t==='gunshop'){desk(0,-6,12);npc(0x5a2a2a,X,Z-8.2,{fem:false});P.push({x:X,z:Z-3.8,l:'Browse weapons & gear',f:()=>shop()});
  for(let i=0;i<7;i++){box(2.2,.5,.5,-12+i*4,3+(i%2),-15.2,0x111111,.3);box(1.6,.25,.3,-12+i*4,3.2+(i%2),-14.9,[0xff4444,0xffaa22,0x44aaff][i%3],1)}
