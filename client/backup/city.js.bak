 if(t==='home'){box(4,.8,6,-11,.4,-11,0x7a8fc0,.6);P.push({x:X-8,z:Z-11,l:'Bed — sleep 8 hours & save',f:()=>fade('😴 Sleeping…',1500,()=>{G.hour=(G.hour+8)%24;me().hp=100;try{save(true)}catch(e){}toast('Rested & saved')})});
  box(3,4,1.5,10,2,-14,0x7a4a2a,.4,1);P.push({x:X+10,z:Z-11.8,l:'Wardrobe — change outfit',f:()=>outfit()});box(2.5,2,1.5,-2,1,-14.3,0x333333,.5,1);P.push({x:X-2,z:Z-12,l:'Safe — stash money',f:()=>stash()});
  box(8,.3,.3,0,.2,-15.3,0x66aaff,1);box(3,2,.4,12,2.5,14.5,0x111122,1.2);box(7,.8,2.5,8,.4,6,0x335577,.6);box(7,.8,2.5,-8,.4,6,0x335577,.6)}
 if(t==='clothes'){desk(0,-6,9);npc(0xb86bff,X,Z-8.2,{name:'Stylist',say:['That colour suits you.','New collection just arrived.','Glasses and caps are on sale — kidding, they are not.']});P.push({x:X,z:Z-3.8,l:'Shop clothes',f:()=>clothes()});
  [-12,-6,6,12].forEach((x,i)=>{box(.8,3,.8,x,1.5,-12,[0xe84a5f,0x2a9d8f,0xf4a261,0x8ecae6][i],.6)});[-10,10].forEach(x=>box(.3,5,6,x,2.5,6,0x9fd8ff,.8,1));[[-4,4],[5,5],[9,-2]].forEach(a=>npc(pick(PCOL),X+a[0],Z+a[1],{ry:rnd(0,6)}))}
 if(t==='restaurant'){desk(8,-9,9);npc(0xffa040,X+8,Z-11.2,{name:'Chef',say:['Everything is fresh today.','The steak? Best in the city.','I used to cook for a gang boss. Never again.']});P.push({x:X+8,z:Z-6.8,l:'Order food',f:()=>food()});
  [[-9,-4],[-9,4],[0,0],[0,8],[9,5]].forEach((a,i)=>{box(2.4,.9,2.4,a[0],.45,a[1],0x8a5a2a,.5,1);box(.8,.5,.8,a[0]-2,.25,a[1],0x333333,.4);box(.8,.5,.8,a[0]+2,.25,a[1],0x333333,.4);if(i%2===0)npc(pick(PCOL),X+a[0]+2.6,Z+a[1],{ry:-1.6})});npc(0xffffff,X-4,Z+2,{patrol:6,name:'Waiter',say:['Table for one? Sit anywhere.','Order at the counter, I will bring the vibes.'],fem:false})}
 if(t==='cinema'){const cv=document.createElement('canvas');cv.width=256;cv.height=128;const ctx=cv.getContext('2d');ctx.textAlign='center';const tex=new THREE.CanvasTexture(cv),scr=new THREE.Mesh(BG,new THREE.MeshBasicMaterial({map:tex}));scr.scale.set(18,8,.3);scr.position.set(X,4.5,Z-15.2);g.add(scr);
  box(5,1.2,2,10,.6,8,0xff3d6e,.6,1);npc(0xff3d6e,X+10,Z+6.2,{name:'Ticket seller',say:['Four films today — all fresh.','Popcorn is extra.','No phones during the film.']});P.push({x:X+10,z:Z+10,l:'Ticket booth — buy ticket & snacks',f:()=>cinemaMenu()});
  for(let r=0;r<4;r++)for(let c=-3;c<=3;c++){if(c===0)continue;box(1.4,.9,1.2,c*2.4,.45,-6+r*3.2,0x7a1230,.5);if(Math.random()<.25)npc(pick(PCOL),X+c*2.4,Z-6+r*3.2+.2,{ry:0,nosay:1})}rooms[t]={X,Z,P,ctx,tex,film:-1}}
 if(t==='bank'){desk(0,-6,14);npc(0x2b5f7a,X-3,Z-8.2,{name:'Teller',say:['Your money is safe with us.','The vault? Absolutely impenetrable.','Please keep your voice down.']});P.push({x:X-3,z:Z-3.8,l:'Teller — deposit / withdraw',f:()=>bank()});
  box(7,6,.6,0,3,-15.3,0x888c94,.7,1);P.push({x:X,z:Z-12,l:'Vault — ROB THE BANK (5★)',f:()=>rob()});[[-8,3],[8,3]].forEach(a=>npc(0x111111,X+a[0],Z+a[1],{watch:1,h:{police:1,swat:1},fem:false,name:'Guard',say:['Do not try anything.','I am watching you.']}));[[-5,6],[5,8]].forEach(a=>npc(pick(PCOL),X+a[0],Z+a[1],{ry:3}))}
 if(t==='police'){desk(0,-6,12);npc(0x2a3f8f,X,Z-8.2,{name:'Desk officer',watch:1,h:{police:1},fem:false,say:['State your business.','We are watching you, citizen.','Wanted level too high? There is a fine for that.']});P.push({x:X,z:Z-3.8,l:'Front desk — pay fine / services',f:()=>police()});
