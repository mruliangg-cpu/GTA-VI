 if(!rooms[t])rooms[t]={X,Z,P}}
function wear(kind){const h=me().m.userData.head;if(h.userData.acc)h.remove(h.userData.acc);h.userData.acc=null;if(!kind)return;const g=new THREE.Group(),b=(c,w,y,z,dz)=>{const m=new THREE.Mesh(BG,mat(c));m.scale.set(w,y,dz);m.position.set(0,0,z);g.add(m);return m};if(kind==='glasses'){b(0x111111,.27,.07,.14,.05).position.y=.02}else{b(0xe84a5f,.32,.1,.02,.34).position.y=.2;b(0xe84a5f,.3,.03,.2,.16).position.y=.16}h.add(g);h.userData.acc=g}
function clothes(){const cols=[0xe84a5f,0x2a9d8f,0xf4a261,0x8ecae6,0x9b5de5,0x222222,0xffd23a,0x7cff6b];menu('CLOTHING STORE','Pick an item.',cols.map(c=>['Shirt #'+c.toString(16).slice(0,3),50,()=>{me().m.userData.torso.material=mat(c)}]).slice(0,5).concat([['Sunglasses',120,()=>wear('glasses')],['Cap',90,()=>wear('cap')],['Remove accessories',0,()=>wear(null)]]),'Stylist',['That colour suits you.','New collection just arrived.'])}
function food(){const eat=(n,a)=>()=>{const c=me();c.hp=Math.min(100,c.hp+n);if(a)G.armor=Math.min(100,G.armor+a);toast('Yum! +'+n+' HP')};menu('RESTAURANT','Menu:',[['☕ Coffee',8,eat(5)],['🍔 Burger',25,eat(20)],['🍕 Pizza',40,eat(35)],['🥩 Steak dinner (+armor)',90,eat(60,25)]],'Chef',['Everything is fresh today.','The steak? Best in the city.'])}
const FILMS=['Neon Chase','Ocean Dreams','Cosmic Cat','Retro Racer'];
function cinemaMenu(){const r=rooms.cinema;menu('CINEMA','Now showing: '+FILMS.join(' · ')+'.',[['🎟 Ticket — random film',30,()=>{r.film=Math.random()*4|0;toast('Now playing: '+FILMS[r.film])}],['🍿 Popcorn',15,()=>toast('Crunch crunch')]],'Ticket seller',['Four films today — all fresh.','No phones during the film.'])}
function drawFilm(r,t){const c=r.ctx,w=256,h=128,f=r.film;c.fillStyle='#000';c.fillRect(0,0,w,h);c.fillStyle='#fff';
 if(f<0){c.font='bold 22px system-ui';c.fillText('🎬 NOW SHOWING',128,56);c.font='14px system-ui';c.fillText('Buy a ticket at the booth',128,84)}
 else if(f===0){c.fillStyle='#1a0033';c.fillRect(0,0,w,h);c.strokeStyle='#ff2bd6';for(let i=0;i<8;i++){const y=64+((i*14+t*40)%64);c.beginPath();c.moveTo(0,y);c.lineTo(w,y);c.stroke()}c.font='28px serif';c.fillText('🚗',(t*70)%300-30,90);c.fillText('🚓',(t*90)%300-80,104);c.font='bold 12px system-ui';c.fillStyle='#fff';c.fillText('NEON CHASE',128,16)}
 else if(f===1){c.fillStyle='#08306b';c.fillRect(0,0,w,h);c.strokeStyle='#6ee0ff';c.lineWidth=3;for(let k=0;k<4;k++){c.beginPath();for(let x=0;x<=w;x+=8)c.lineTo(x,50+k*18+Math.sin(x/20+t*2+k)*6);c.stroke()}c.font='26px serif';c.fillText('🐬',128+Math.sin(t)*60,40+Math.cos(t*2)*10)}
 else if(f===2){for(let i=0;i<30;i++)c.fillRect((i*53+t*10)%w,(i*29)%h,2,2);c.font='34px serif';c.fillText('🐱',128+Math.cos(t)*70,70+Math.sin(t)*30);c.fillText('🪐',210,30)}
 else{c.fillStyle='#ff7a3c';c.fillRect(0,0,w,64);c.fillStyle='#ffd23a';c.beginPath();c.arc(128,60,30,0,7);c.fill();c.fillStyle='#222';c.fillRect(0,70,w,58);c.fillStyle='#fff';for(let i=0;i<6;i++)c.fillRect(((i*60-t*120)%320+320)%320-30,98,30,4);c.font='28px serif';c.fillText('🏎',128,96)}
 r.tex.needsUpdate=true}
function bank(){menu('BANK','Bank balance: '+money(bankv)+'.',[['Deposit $1,000',0,()=>{G.money-=1000;bankv+=1000},()=>{if(G.money<1000){toast('Not enough cash');return false}}],['Withdraw $1,000',0,()=>{bankv-=1000;G.money+=1000},()=>{if(bankv<1000){toast('Not enough in account');return false}}]],'Teller',['Your money is safe with us.','Please keep your voice down.'])}
function rob(){if(performance.now()/1000-lastRob<240)return toast('The vault is empty — come back later');lastRob=performance.now()/1000;fade('💰 Cracking the vault…',2500,()=>{const g=3000+(Math.random()*5000|0);G.money+=g;heat(5);toast('ALARM! You grabbed '+money(g)+' — RUN!')})}
function police(){const st=G.wanted||0;menu('POLICE STATION','Stars: '+st+'.',[['Pay fine — clear wanted level',400*st,()=>{G.wanted=0;G.lose=0;toast('Record cleared')},()=>{if(!st){toast('You are clean');return false}}],['Report a lost wallet (free)',0,()=>toast('Filed. Do not hold your breath.')]],'Desk officer',['State your business.','We are watching you, citizen.'])}
function armory(){menu('ARMORY','Military surplus:',[['Military body armor',300,()=>{G.armor=100}],['Grenades x5',900,()=>{arms.gren+=5;saveArms()}],['Ammo crate (+90)',200,()=>{G.res+=90}],['Rifle',4000,()=>{if(!arms.own.includes('rifle')){arms.own.push('rifle');saveArms()}equip('rifle')},()=>{if(arms.own.includes('rifle')){toast('You already own it');return false}}]],'Quartermaster',['Armory is open to visitors with a pass.','Nobody enters the hangar.'])}

function enter(t){if(!guard()||inside)return;if(G.veh)return toast('Get out of the car first');if(G.wanted>0&&t!=='hospital')return toast('Police are after you — lose the stars first');
 const tk={casino:100,military:500}[t]||0;if(G.money<tk)return toast('Entry costs '+money(tk));if(!rooms[t])build(t);const r=rooms[t],c=me();
 fade((TYPES[t].f)+' '+TYPES[t].n,500,()=>{G.money-=tk;ret={x:c.x,z:c.z};inside=t;window.INSIDE=true;pts=r.P;c.x=r.X;c.z=r.Z+11;G.cy=Math.PI;if(G.cp)G.cp=.25;alarm=0;alarmT=0;if(t==='cinema')r.film=-1;if(tk)toast('Paid '+money(tk))})}
function leave(){if(!inside)return;closePanel();const was=inside;fade('',400,()=>{if(alarm){heat(was==='military'?5:4);alarm=0;toast('You fired a weapon inside — WANTED!')}const c=me();c.x=ret.x;c.z=ret.z+3;inside=null;window.INSIDE=false;pts=[]})}
/* ---------- panels ---------- */
function closePanel(){if(panel){panel.remove();panel=null}}
function open_(title,fn){closePanel();for(const k of['KeyW','KeyA','KeyS','KeyD','Fire'])K[k]=0;if(document.exitPointerLock)document.exitPointerLock();panel=document.createElement('div');panel.id='cv';['touchstart','touchmove','touchend'].forEach(t=>panel.addEventListener(t,e=>e.stopPropagation(),{passive:true}));
 const d=document.createElement('div');d.className='in';const h=document.createElement('h2');h.textContent=title;d.append(h);panel.append(d);document.body.append(panel);panel._d=d;fn(d);return d}
const btn=(p,t,f,on)=>{const b=document.createElement('button');b.textContent=t;if(on)b.className='on';b.onclick=f;p.append(b);return b};
function betBar(d,redraw){const w=document.createElement('div');d.append(w);const p=document.createElement('p');p.textContent='Bet:';w.append(p);[50,200,1000,5000].forEach(v=>btn(w,'$'+v,()=>{bet=v;redraw()},bet===v));const m=document.createElement('p');m.id='mm2';m.textContent='Your money: '+money(G.money);d.append(m)}
const pay=(w)=>{G.money+=w};
const homeSave=()=>{};
function stash(){const draw=()=>open_('SAFE',d=>{const p=document.createElement('p');p.textContent='Cash on you: '+money(G.money)+'  ·  In the safe: '+money(home.stash);d.append(p);[1000,10000].forEach(v=>{btn(d,'Deposit '+money(v),()=>{if(G.money<v)return toast('Not enough cash');G.money-=v;home.stash+=v;saveHome();draw()});btn(d,'Withdraw '+money(v),()=>{if(home.stash<v)return toast('Not enough in safe');home.stash-=v;G.money+=v;saveHome();draw()})});btn(d,'Close',closePanel)});draw()}
/* ---------- weapons & gear ---------- */
const GUNS={pistol:{dmg:34,cd:.25,mag:12,n:'Pistol'},smg:{dmg:17,cd:.09,mag:30,n:'SMG'},shotgun:{dmg:110,cd:.9,mag:6,n:'Shotgun'},rifle:{dmg:60,cd:.35,mag:20,n:'Rifle'}};
let home={own:0,stash:0},arms={own:['pistol'],gren:0},gun='pistol',mags={},acc=0,grens=[];
try{Object.assign(home,JSON.parse(localStorage.getItem('vcu_home')));Object.assign(arms,JSON.parse(localStorage.getItem('vcu_arms')))}catch(e){}
const saveHome=()=>{try{localStorage.setItem('vcu_home',JSON.stringify(home))}catch(e){}},saveArms=()=>{try{localStorage.setItem('vcu_arms',JSON.stringify(arms))}catch(e){}};
function equip(g){if(!arms.own.includes(g))return toast('You do not own the '+GUNS[g].n);mags[gun]=G.ammo;gun=g;G.ammo=mags[g]==null?GUNS[g].mag:mags[g];G.wep=2;toast(GUNS[g].n)}
function shop(){const draw=()=>open_('GUN SHOP',d=>{const m=document.createElement('p');m.textContent='Your money: '+money(G.money);d.append(m);
 const item=(l,pr,f,own)=>{const b=btn(d,own?'✔ '+l:l+' — '+money(pr),()=>{if(own)return;if(G.money<pr)return toast('Not enough money');G.money-=pr;f();saveArms();draw()});b.style.display='block';b.style.width='100%'};
 item('Body armor (full)',400,()=>{G.armor=100;toast('Armor equipped')});item('Ammo box (+60)',150,()=>{G.res+=60});item('Grenades x3 (G to throw)',600,()=>{arms.gren+=3});
 for(const g of['smg','shotgun','rifle'])item(GUNS[g].n,{smg:1500,shotgun:2200,rifle:4500}[g],()=>{arms.own.push(g);equip(g)},arms.own.includes(g));
 btn(d,'Close',closePanel)});draw()}
function throwGren(){if(!guard()||inside||G.veh)return;if(arms.gren<=0)return toast('No grenades — buy them in a Gun Shop');arms.gren--;saveArms();const c=me(),f=[Math.sin(G.cy),Math.cos(G.cy)],m=new THREE.Mesh(SG,mat(0x2f5a2f));m.scale.set(.5,.5,.5);scene.add(m);grens.push({m,sx:c.x,sz:c.z,tx:c.x+f[0]*16,tz:c.z+f[1]*16,t:0})}
function boom(x,z){const m=new THREE.Mesh(SG,new THREE.MeshBasicMaterial({color:0xff9a2a,transparent:true,opacity:.8}));m.position.set(x,1.5,z);scene.add(m);grens.push({fx:m,t:0});
 peds.forEach(p=>{if(p.alive&&Math.hypot(p.m.position.x-x,p.m.position.z-z)<9)killPed(p,true)});offs.forEach(o=>{if(o.alive&&o.st!=='in'&&Math.hypot(o.x-x,o.z-z)<9){o.hp-=120;if(o.hp<=0)killCop(o)}});cars.forEach(o=>{if(o.type!=='wreck'&&Math.hypot(o.x-x,o.z-z)<10)dmgCar(o,150)});const c=me(),d=Math.hypot(c.x-x,c.z-z);if(d<7)dmgP(55*(1-d/7));heat(3)}
function gtick(dt){for(const g of grens.slice()){g.t+=dt;if(g.fx){g.fx.scale.setScalar(2+g.t*30);g.fx.material.opacity=Math.max(0,.8-g.t*2);if(g.t>.45){scene.remove(g.fx);grens.splice(grens.indexOf(g),1)}continue}
 const u=Math.min(1,g.t/1.3);g.m.position.set(g.sx+(g.tx-g.sx)*u,.3+Math.sin(u*Math.PI)*5,g.sz+(g.tz-g.sz)*u);if(g.t>1.5){scene.remove(g.m);grens.splice(grens.indexOf(g),1);boom(g.tx,g.tz)}}}
function slots(){const S=['🍒','🍋','🔔','⭐','7️⃣'],draw=()=>open_('SLOT MACHINE',d=>{betBar(d,draw);const big=document.createElement('div');big.className='big';big.textContent=draw.r||'❔ ❔ ❔';d.append(big);const res=document.createElement('p');res.textContent=draw.t||'Triple = x10 (777 = x25) · pair = x0.8';d.append(res);
  btn(d,'SPIN',()=>{if(G.money<bet)return toast('Not enough money');G.money-=bet;const r=[0,0,0].map(()=>S[Math.random()*5|0]);let w=0;if(r[0]===r[1]&&r[1]===r[2])w=bet*(r[0]==='7️⃣'?25:10);else if(r[0]===r[1]||r[1]===r[2]||r[0]===r[2])w=Math.round(bet*.8);pay(w);draw.r=r.join(' ');draw.t=w>bet?'WIN '+money(w)+'!':w?'Back '+money(w):'No luck';draw()});btn(d,'Leave',closePanel)});draw.r=0;draw()}
function roulette(){const RED=[1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36],draw=()=>open_('ROULETTE',d=>{betBar(d,draw);const big=document.createElement('div');big.className='big';big.textContent=draw.r||'🎡';d.append(big);const res=document.createElement('p');res.textContent=draw.t||'Red / Black pays x2 · Green (0) pays x14';d.append(res);
  [['Red','#e33',2],['Black','#333',2],['Green','#2a2',14]].forEach(([n,col,mul])=>{const b=btn(d,n+' x'+mul,()=>{if(G.money<bet)return toast('Not enough money');G.money-=bet;const x=Math.random()*37|0,c=x===0?'Green':RED.includes(x)?'Red':'Black';const w=c===n?bet*mul:0;pay(w);draw.r=x+' '+c;draw.t=w?'WIN '+money(w)+'!':'You lost '+money(bet);draw()});b.style.background=col;b.style.color='#fff'});btn(d,'Leave',closePanel)});draw.r=0;draw()}
function dice(){const draw=()=>open_('DICE (2 dice)',d=>{betBar(d,draw);const big=document.createElement('div');big.className='big';big.textContent=draw.r||'🎲 🎲';d.append(big);const res=document.createElement('p');res.textContent=draw.t||'Under 7 / Over 7 pay x2.2 · exactly 7 pays x5';d.append(res);
  [['Under 7',s=>s<7,2.2],['Exactly 7',s=>s===7,5],['Over 7',s=>s>7,2.2]].forEach(([n,ok,mul])=>btn(d,n,()=>{if(G.money<bet)return toast('Not enough money');G.money-=bet;const a=1+Math.random()*6|0,b=1+Math.random()*6|0,w=ok(a+b)?Math.round(bet*mul):0;pay(w);draw.r='🎲 '+a+'  🎲 '+b+'  = '+(a+b);draw.t=w?'WIN '+money(w)+'!':'You lost '+money(bet);draw()}));btn(d,'Leave',closePanel)});draw.r=0;draw()}
function outfit(){open_('WARDROBE',d=>{const p=document.createElement('p');p.textContent='Pick a shirt colour:';d.append(p);[0xe84a5f,0x2a9d8f,0xf4a261,0x8ecae6,0xffffff,0x9b5de5,0x222222,0xffd23a,0x2e7fbf,0x7cff6b,0xff7ab8,0x8a5a2a].forEach(c=>{const s=document.createElement('span');s.className='sw';s.style.background='#'+c.toString(16).padStart(6,'0');s.onclick=()=>{me().m.userData.torso.material=mat(c)};d.append(s)});d.append(document.createElement('br'));btn(d,'Done',closePanel)})}
/* ---------- phone (L) ---------- */
function say(t){try{if(ph.tts&&window.speechSynthesis){const u=new SpeechSynthesisUtterance(t);speechSynthesis.cancel();speechSynthesis.speak(u)}}catch(e){}}
function phone(tab){if(!guard()||$('set'))return;tab=tab||'home';open_('📱 PHONE',d=>{
 if(tab==='home'){btn(d,'🚕 Taxi',()=>phone('taxi'));btn(d,'💬 Messages',()=>phone('msg'));btn(d,'🗺 Map',()=>{closePanel();KEYS.open('map')});btn(d,'Close',closePanel)}
 if(tab==='taxi'){const W=window.KEYS_WAYPOINT&&KEYS_WAYPOINT(),m=me(),p=document.createElement('p');d.append(p);
  if(!W){p.textContent='Pick a destination on the map first (tap the map to place a waypoint).';btn(d,'Open map',()=>{closePanel();KEYS.open('map')})}
  else{const dist=Math.hypot(W.x-m.x,W.z-m.z),fare=Math.round(15+dist*.15);p.textContent='Destination set · '+Math.round(dist)+' m · fare '+money(fare);btn(d,'Order taxi '+money(fare),()=>{if(inside)return toast('Leave the building first');if(G.veh)return toast('Get out of the car first');if(G.money<fare)return toast('Need '+money(fare));closePanel();G.money-=fare;
   fade('🚕 Taxi on the way…',clamp(dist*6,1500,5000),()=>{muteUntil=performance.now()+Math.hypot(W.x-m.x,W.z-m.z)/70*1000+1500;const o={x:W.x,z:W.z};hitWall(o,3);m.x=o.x;m.z=o.z;toast('Taxi: we have arrived')})})}
  btn(d,'Back',()=>phone('home'))}
 if(tab==='msg'){const O=window.UlianOnline;if(!O||!O.me||String(O.me.id).startsWith('guest')||O.status!=='connected'){const p=document.createElement('p');p.textContent='Log in via ONLINE and connect to message friends.';d.append(p);btn(d,'Back',()=>phone('home'));return}
  if(ph.thread){const f=ph.thread,box=document.createElement('div');box.style.cssText='max-height:45vh;overflow:auto';(ph.msgs[f.id]||[]).forEach(m=>{const e=document.createElement('div');e.className='m'+(m.me?' me':'');e.textContent=m.text;box.append(e)});d.append(box);const i=document.createElement('input');i.placeholder='Message to '+f.name;i.maxLength=200;d.append(i);
   const send=()=>{const t=i.value.trim();if(!t)return;O.dm(f.id,t);(ph.msgs[f.id]=ph.msgs[f.id]||[]).push({me:1,text:t});phone('msg')};i.onkeydown=e=>{if(e.key==='Enter')send()};btn(d,'Send',send);btn(d,'Voice '+(ph.tts?'ON':'OFF'),()=>{ph.tts=!ph.tts;phone('msg')});btn(d,'Back',()=>{ph.thread=null;phone('msg')});setTimeout(()=>{box.scrollTop=1e9},0)}
  else{const p=document.createElement('p');p.textContent=ph.fr?'Friends (tap to chat). Incoming messages are read aloud when Voice is ON.':'Loading friends…';d.append(p);
   if(!ph.fr)O.friends().then(r=>{ph.fr=r.friends;if(panel)phone('msg')}).catch(()=>toast('Could not load friends'));else ph.fr.forEach(f=>btn(d,'💬 '+f.name,()=>{ph.thread=f;phone('msg')}));btn(d,'Back',()=>phone('home'))}}})}
/* ---------- tick + hooks ---------- */
function tick(dt){gtick(dt);const w=$('wp');if(w&&G.wep===2&&gun!=='pistol')w.textContent=GUNS[gun].n+' '+G.ammo+' / '+G.res+(arms.gren?'  💣'+arms.gren:'');else if(w&&arms.gren)w.textContent+='  💣'+arms.gren;if(!inside)return;const c=me(),pr=$('prompt');let t='',near=null,bd=3.6;const R=rooms[inside];if((inside==='police'||inside==='military')&&G.wep===2&&K.Fire)alarm=1;if(inside==='military'&&c.z<R.Z-5.5){alarmT+=dt;if(alarmT>.2)toast('⚠ RESTRICTED AREA — go back!');if(alarmT>3){alarm=1;alarmT=0;leave()}}else alarmT=0;if(R.rotor)R.rotor.rotation.y+=dt*14;if(inside==='cinema'&&R.ctx)drawFilm(R,performance.now()/1000);for(const p of pts){const d=Math.hypot(c.x-p.x,c.z-p.z);if(d<bd){bd=d;near=p}}if(near&&!panel)t='[E] '+near.l;pr.hidden=!t;pr.textContent=t;
 for(const n of npcs){if(n.w){n.m.rotation.y=Math.atan2(c.x-n.m.position.x,c.z-n.m.position.z);continue}n.t+=dt;const s=Math.sin(n.t*.5),x=n.x0+s*n.a;n.m.position.x=x;n.m.rotation.y=Math.cos(n.t*.5)>0?1.57:-1.57;animH(n.m,n.t*6,1,'walk')}}
const near=()=>{const c=me();let b=null,bd=3.6;for(const p of pts){const d=Math.hypot(c.x-p.x,c.z-p.z);if(d<bd){bd=d;b=p}}return b};
window.CITY={_dbg:{build,rooms,get inside(){return inside}},boot(){venues();signs();
 const f=document.createElement('div');f.id='fadev';document.body.append(f);
 const _hud=window.hud;window.hud=function(dt){_hud(dt);try{tick(dt)}catch(e){}};
 for(const n of['spawns','copsUpdate']){const o=window[n];window[n]=function(){if(inside)return;return o.apply(this,arguments)}}
 const _on=window.onKey;window.onKey=function(k){if(inside&&k==='KeyE'){if(panel)return;const p=near();p&&p.f();return}
  if(guard()&&!panel){if(k==='KeyG'||k==='Digit6')return throwGren();if(k==='Digit3'||k==='Digit4'||k==='Digit5')return equip({Digit3:'smg',Digit4:'shotgun',Digit5:'rifle'}[k]);if(k==='Digit2'&&gun!=='pistol'&&G.wep!==2){G.wep=2;return}
   if(k==='Weapon'){const l=[0].concat(arms.own),cur=G.wep===1?0:arms.own.indexOf(gun)+1,n=l[(cur+1)%l.length];if(n===0){G.wep=1}else{equip(n)}return}
   if(k==='KeyR'&&G.wep===2&&gun!=='pistol'){const n=Math.min(GUNS[gun].mag-G.ammo,G.res);G.ammo+=n;G.res-=n;return}}
  return _on(k)};
 const _sh=window.shoot;window.shoot=function(){if(G.wep===1||gun==='pistol')return _sh();const g=GUNS[gun];if(G.ammo<=0){G.cd=.3;return toast('Reload (R)')}const a=G.ammo-1;acc+=g.dmg/34;while(acc>=1){G.ammo=99;_sh();acc--}G.ammo=a;G.cd=g.cd}
 const _init=window.initGame;window.initGame=function(c){inside=null;window.INSIDE=false;pts=[];closePanel();return _init(c)};
 const _die=window.die;window.die=function(){if(inside){inside=null;window.INSIDE=false;pts=[];closePanel()}return _die.apply(this,arguments)};
 const _save=window.save;window.save=function(a){if(inside&&ret){const c=me(),x=c.x,z=c.z;c.x=ret.x;c.z=ret.z+3;try{return _save(a)}finally{c.x=x;c.z=z}}return _save(a)};
 addEventListener('keydown',e=>{if(e.target&&e.target.tagName==='INPUT'){e.stopPropagation();return}if(!guard()||$('set')||$('kv'))return;const c=window.USET?USET.map(e.code):e.code;
  if(panel&&(e.code==='Escape'||e.code==='Tab')){closePanel();e.preventDefault();e.stopPropagation();return}if(panel){e.stopPropagation();return}
  if(c==='KeyL'){e.preventDefault();e.stopPropagation();if(!e.repeat)phone()}},true);
 const t=$('touch');if(t){const b=document.createElement('button');b.className='kb';b.textContent='PHONE';b.style.top='calc(env(safe-area-inset-top,0px) + 326px)';b.addEventListener('touchstart',e=>{e.preventDefault();e.stopPropagation();panel?closePanel():phone()},{passive:false});b.onclick=()=>panel?closePanel():phone();t.append(b)}
 const O=window.UlianOnline;if(O){const _s=O.sendState;O.sendState=function(p){if(inside||performance.now()<muteUntil)return;return _s.call(this,p)}}
 if(t){const gb=document.createElement('button');gb.className='kb';gb.textContent='GRENADE';gb.style.top='calc(env(safe-area-inset-top,0px) + 390px)';gb.addEventListener('touchstart',e=>{e.preventDefault();e.stopPropagation();throwGren()},{passive:false});t.append(gb)}
 if(O)O.on('dm',m=>{(ph.msgs[m.from]=ph.msgs[m.from]||[]).push({text:m.text});toast('💬 '+m.name+': '+m.text);say(m.name+' says: '+m.text);if(panel&&ph.thread&&ph.thread.id===m.from)phone('msg')})}};
})();
