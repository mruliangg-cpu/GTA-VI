  [[-6,2],[6,2],[0,8]].forEach(a=>npc(0x2a3f8f,X+a[0],Z+a[1],{watch:1,h:{police:1},fem:false,name:'Officer',say:['Keep your hands where I can see them.','No weapons inside.']}))}
 if(t==='military'){desk(-9,-2,7);npc(0x4a5a30,X-9,Z-4.2,{name:'Quartermaster',watch:1,h:{police:1,swat:1},fem:false,say:['Armory is open to visitors with a pass.','Nobody enters the hangar.']});P.push({x:X-9,z:Z+.4,l:'Armory',f:()=>armory()});
